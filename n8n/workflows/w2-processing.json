{
  "id": "prospectW2Traite",
  "name": "W2 · Traitement des nouveaux prospects",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9-18 * * 1-5"
            }
          ]
        }
      },
      "id": "382f89fb-ffa4-54ce-99dc-eec56a608c17",
      "name": "Toutes les heures (jours ouvrés)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "a99c0310-2fbd-5c58-9907-09571138eddf",
      "name": "Lancer maintenant",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/prospects",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "new"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "da06559a-eb7d-58ca-bcd5-44fe9ff0c29d",
      "name": "Prospects à traiter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "prospectApiCreds",
          "name": "Prospecting API"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "c88212a0-ffdd-500b-b678-124c647b4fb4",
      "name": "Un prospect à la fois",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/prospects/{{ $('Un prospect à la fois').item.json.id }}/enrich",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "id": "7a3e2275-5c36-5358-8afd-d88823bceebd",
      "name": "Compléter l'entreprise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "prospectApiCreds",
          "name": "Prospecting API"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Facultatif : un échec (pas d'entreprise, API indisponible) n'arrête pas le traitement."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/prospects/{{ $('Un prospect à la fois').item.json.id }}/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "3116c4e9-c293-57c5-8509-c50c728c44cc",
      "name": "Rechercher et rédiger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        960,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "prospectApiCreds",
          "name": "Prospecting API"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Appel long (recherche web + rédaction). Réponse complète pour trier les codes HTTP."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "9f86f276-73e0-5ba6-adfd-15382a59cd52",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 200,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Traité"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "d1e50f2c-9ec8-5f7c-a801-e8dd3dfef5c4",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 409,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Déjà pris"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Erreur"
        }
      },
      "id": "2acfd3c7-dcf9-5b45-934b-6d234a44c967",
      "name": "Selon le résultat",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ $json.body }}",
        "options": {}
      },
      "id": "43280727-c3ce-5659-a30e-40d4b8814eb1",
      "name": "Résultat",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "d4f5812a-f807-50d1-8b9a-b48f5d87c815",
              "leftValue": "={{ $json.draft }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "17c2dc7f-fb81-5894-b9ee-f9453cc9f638",
      "name": "Brouillon créé ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "prospectW3Review",
          "mode": "list",
          "cachedResultName": "W3 · Validation des brouillons"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "c431b8cf-9c6f-5975-94d0-473dd1b51cf5",
      "name": "Demander la validation (W3)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1920,
        -100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "={{ '❌ *Traitement impossible* pour le prospect #' + $('Un prospect à la fois').item.json.id + ' (HTTP ' + $json.statusCode + ')\\n' + String(($json.body?.detail ?? $json.error?.message ?? JSON.stringify($json.body)) ?? '').replace(/([_*`\\[])/g, '\\\\$1') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "id": "b14e0eb3-4d86-5733-be97-62b8912d9c59",
      "name": "Signaler l'échec",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1440,
        250
      ],
      "credentials": {
        "telegramApi": {
          "id": "prospectTelegram",
          "name": "Telegram Prospection"
        }
      },
      "webhookId": "ef190ef3-8475-5d20-bb6b-9e5482d2ae66"
    },
    {
      "parameters": {},
      "id": "0592ba2a-812d-5a32-b73e-82912736b934",
      "name": "Prospect suivant",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2160,
        100
      ]
    }
