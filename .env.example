# Copier en .env (jamais commité) puis remplir.
# Générer chaque secret avec : openssl rand -hex 32
# Conserver une copie de ce fichier dans un gestionnaire de mots de passe :
# sans N8N_ENCRYPTION_KEY, les identifiants n8n sauvegardés sont illisibles.

# Domaine public de n8n (enregistrement DNS A/AAAA vers le VPS)
N8N_DOMAIN=n8n.example.fr
# Fixer une version précise de n8n et la mettre à jour volontairement
N8N_VERSION=stable

POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
APP_DB_PASSWORD=
N8N_ENCRYPTION_KEY=

# Secret partagé entre n8n et l'API (en-tête X-API-Key)
API_KEY=
# Salt de hachage de la liste d'opposition : ne jamais le changer une fois en production
OPTOUT_SALT=

ANTHROPIC_API_KEY=

# Bot Telegram (notifications et validation) : voir docs/ARCHITECTURE.md § 8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sauvegarde hors site (restic), optionnelle mais fortement recommandée
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Développement local uniquement (docker-compose.dev.yml)
# DEV_HTTPS_PORT=8443
# DEV_POSTGRES_PORT=5433
# URL publique d'un tunnel (ngrok...) : nécessaire pour les boutons Telegram
# DEV_WEBHOOK_URL=https://xxxx.ngrok-free.app/
